                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"<integer>\",\n  \"reason\": \"<string>\",\n  \"acc_type\": \"<string>\",\n  \"notify_buyer\": 1\n}",
