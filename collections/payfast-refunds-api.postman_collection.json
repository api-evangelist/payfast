          "name": "Create a refund",
          "request": {
            "name": "Create a refund",
            "description": {
              "content": "Initiate a refund for a completed transaction. Specify the refund amount, reason, and account type. Refunds are not available in sandbox mode.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "refunds",
                ":id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
